FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvConstraints;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

limitT
{
    type            limitTemperature;
    cellZone        all;
    min             50;
    max             2000;
}

boundK
{
    type            bound;
    field           k;
    min             1e-8;
}

boundOmega
{
    type            bound;
    field           omega;
    min             100;
}

boundNut
{
    type            bound;
    field           nut;
    min             1e-7;
}

