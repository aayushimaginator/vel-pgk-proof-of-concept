FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      functions;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#includeFunc MachNo
#includeFunc residuals

forceCoeffs1
{
    type            forceCoeffs;
    libs            ("libforces.so");
    patches         (projectile);
    rho             rhoInf;
    rhoInf          1.225;
    liftDir         (0 0 1);
    dragDir         (1 0 0);
    CofR            (0 0 0);
    pitchAxis       (0 1 0);
    magUInf         680;
    lRef            0.1;
    Aref            0.0078;
    writeControl    timeStep;
    writeInterval   1;
}

forces1
{
    type            forces;
    libs            ("libforces.so");
    patches         (projectile);
    rho             rhoInf;
    rhoInf          1.225;
    CofR            (0 0 0);
    writeControl    timeStep;
    writeInterval   1;
}

