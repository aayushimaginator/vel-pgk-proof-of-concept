FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

omegaInlet      4750;

dimensions      [turbulentOmega];

internalField   uniform $omegaInlet;
boundaryField
{
    inlet
    {
        type            inletOutlet;
        inletValue      uniform $omegaInlet;
    }
    outlet
    {
        type            inletOutlet;
        inletValue      uniform $omegaInlet;
    }
    tunnelWalls
    {
        type            inletOutlet;
        inletValue      uniform $omegaInlet;
    }
    projectile
    {
        type            omegaWallFunction;
        value           uniform $omegaInlet;
    }
    #includeEtc "caseDicts/setConstraintTypes"
}

