FoamFile
{
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

Uinlet          (680 0 0);

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform $Uinlet;

boundaryField
{
    inlet
    {
        type            freestreamVelocity;
        freestreamValue uniform $Uinlet;
    }
    outlet
    {
        type            freestreamVelocity;
        freestreamValue uniform $Uinlet;
    }
    tunnelWalls
    {
        type            freestreamVelocity;
        freestreamValue uniform $Uinlet;
    }
    projectile
    {
        type            noSlip;
    }
}

